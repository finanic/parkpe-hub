# Copy to apps/backend/.env and fill locally. Never commit .env.
# Loaded by config/envfile.py for auth (:4600) and Django API (:4610).
# Do not paste secrets into chat. Leave secret values empty in this file.

# --- Django API (manage.py / :4610) ---
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# HUB_DB_PATH=
# AUTH_BASE_URL=http://127.0.0.1:4600
# HUB_API_ORIGIN=http://127.0.0.1:4610

# --- Auth process (run.py / :4600) ---
# AUTH_HOST=127.0.0.1
# AUTH_PORT=4600
# AUTH_ORIGINS=http://127.0.0.1:4310,http://127.0.0.1:4500,http://127.0.0.1:4600
# AUTH_COOKIE_SECURE=0
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_SCRYPT_N=32768
# AUTH_DATA_DIR=

# --- Mail (PHP under Mail Setup/) — relative to apps/backend/ ---
AUTH_MAIL_CONFIG=Mail Setup/contact.config.php
AUTH_SES_SMTP_PHP=Mail Setup/ses-smtp.php

# --- Kaleyra SMS (see integrations/kaleyra.py) ---
KALEYRA_API_KEY=
KALEYRA_ACCOUNT_SID=
KALEYRA_BASE_URL=https://api.kaleyra.io
KALEYRA_SMS_PATH=messages
KALEYRA_TIMEOUT=10
KALEYRA_SENDER_ID=
KALEYRA_OTP_TEMPLATE_ID=
KALEYRA_OTP_BODY_TEMPLATE=
KALEYRA_PARKPE_SENDER_ID=
KALEYRA_PARKPE_TEMPLATE_ID=
KALEYRA_PARKPE_BODY=
KALEYRA_PAYSWAP_SENDER_ID=
KALEYRA_PAYSWAP_TEMPLATE_ID=
KALEYRA_PAYSWAP_BODY=

# --- Cashfree Secure ID (KYC / DigiLocker) ---
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_PUBLIC_KEY_PATH=
CASHFREE_VERIFICATION_BASE_URL=https://api.cashfree.com

# --- Cashfree Payment Gateway (wallet top-up / direct pay) ---
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET=
CASHFREE_PG_ENV=sandbox
CASHFREE_PG_RETURN_URL=http://127.0.0.1:4500/#wallet
# CASHFREE_PG_NOTIFY_URL=
# Unpaid PG orders older than this (minutes) are re-checked, then marked failed if still not paid.
# PG_ORDER_STALE_MINUTES=30

# --- Mobikwik BBPS (BASE_URL required when ENABLED=1; no silent prod fallback) ---
MOBIKWIK_BBPS_ENABLED=0
MOBIKWIK_BBPS_ENVIRONMENT=UAT
MOBIKWIK_BBPS_BASE_URL=https://rapi-b2b.mobikwik.com
MOBIKWIK_BBPS_CLIENT_ID=
MOBIKWIK_BBPS_CLIENT_SECRET=
MOBIKWIK_BBPS_MERCHANT_ID=
MOBIKWIK_BBPS_API_KEY=
MOBIKWIK_BBPS_SECRET_KEY=
MOBIKWIK_BBPS_MEMBER_ID=
MOBIKWIK_BBPS_AGENT_ID=
MOBIKWIK_BBPS_PUBLIC_KEY_PATH=

# --- PayU Hosted Checkout ---
# Dashboard: Key, Salt-32 bit (v1), Salt-256 bit (v2). Dual accounts need both salts.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MERCHANT_SALT_V2=
# v1 = plain hex (Salt-32 only). dual = {"v1","v2"} JSON. Empty → dual if SALT_V2 set.
PAYU_HASH_MODE=
PAYU_ENV=test
APP_BASE_URL=http://127.0.0.1:4610
PAYSWAP_ORIGIN=http://127.0.0.1:4500
# Optional override when admin policy is unset: cashfree | payu | both
PAYSWAP_PG_PROVIDER=both
